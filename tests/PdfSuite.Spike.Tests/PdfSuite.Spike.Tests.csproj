<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The glyph-level redaction probe calls PDFium directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfSuite.Pdf.Pdfium\PdfSuite.Pdf.Pdfium.csproj" />
    <ProjectReference Include="..\..\src\PdfSuite.Pdf.Remote\PdfSuite.Pdf.Remote.csproj" />
    <ProjectReference Include="..\..\src\PdfSuite.Pdf.Qpdf\PdfSuite.Pdf.Qpdf.csproj" />
    <ProjectReference Include="..\..\src\PdfSuite.Pdf.Redaction\PdfSuite.Pdf.Redaction.csproj" />
    <!-- Referenced so the worker executable is copied next to the tests, which start it. -->
    <ProjectReference Include="..\..\src\PdfSuite.Pdf.Worker\PdfSuite.Pdf.Worker.csproj" />
    <ProjectReference Include="..\..\tools\PdfSuite.FixtureGenerator\PdfSuite.FixtureGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    No telemetry from test runs. xunit.v3 brings in Microsoft.Testing.Extensions.Telemetry, which
    reports to dc.services.visualstudio.com unless TESTINGPLATFORM_TELEMETRY_OPTOUT or
    DOTNET_CLI_TELEMETRY_OPTOUT is set. Removing its builder hook stops it from being registered.
  -->
  <ItemGroup>
    <TestingPlatformBuilderHook Remove="98058041-B5B6-4A75-9834-58E6DF796A22" />
  </ItemGroup>

</Project>
