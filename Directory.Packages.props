<Project>
  <!-- Every version here must have a matching entry in docs/licensing/dependency-inventory.md. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup Label="PDF engine (native binaries, non-V8 builds)">
    <PackageVersion Include="bblanchon.PDFium.Win32" Version="158.0.8111" />
    <PackageVersion Include="bblanchon.PDFium.Linux" Version="158.0.8111" />
    <PackageVersion Include="bblanchon.PDFium.macOS" Version="158.0.8111" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <!-- xunit.v3 runs on Microsoft.Testing.Platform (enabled in global.json); no VSTest adapter is needed. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
