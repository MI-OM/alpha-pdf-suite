<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Runs the AOT and trimming analyzers on every build. Packaging publishes with -p:PublishAot=true
      (tools/package/publish.ps1); setting PublishAot here would make restore add this machine's
      RID, so the committed lock files would differ between operating systems (spike S6).
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfSuite.Pdf.Remote\PdfSuite.Pdf.Remote.csproj" />
    <!-- Referenced so the worker executable is built and copied next to the app. The app never calls PDFium itself. -->
    <ProjectReference Include="..\PdfSuite.Pdf.Worker\PdfSuite.Pdf.Worker.csproj" />
  </ItemGroup>

</Project>
