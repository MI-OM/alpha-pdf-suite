<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfSuite.Pdf.Abstractions\PdfSuite.Pdf.Abstractions.csproj" />
  </ItemGroup>

  <!-- The glyph-level redaction probe drives PDFium's API directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PdfSuite.Spike.Tests" />
  </ItemGroup>

  <!-- Prebuilt non-V8 PDFium binaries. Each package carries runtimes/<rid>/native for its OS. -->
  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" />
    <PackageReference Include="bblanchon.PDFium.Linux" />
    <PackageReference Include="bblanchon.PDFium.macOS" />
  </ItemGroup>

</Project>
